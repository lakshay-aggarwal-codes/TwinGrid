# TwinGrid frontend environment. Copy to .env (dev) or .env.production (build).
# Vite inlines every VITE_* value into the JavaScript bundle at BUILD time --
# changing them requires a rebuild, and NOTHING here is secret (see the
# warning on VITE_DEMO_PASSWORD). Never put a real credential in a VITE_ var.
# `npm run build` fails if a required one is missing (see vite.config.ts).

# REQUIRED. Backend base URL, no trailing slash. The WebSocket URL is derived
# from it (https -> wss). In `npm run dev` only, an unset value falls back to
# http://localhost:8000; production builds have no fallback and reject localhost.
VITE_API_BASE_URL=http://localhost:8000

# REQUIRED. Login for the shared read-only demo account the app signs in with
# automatically (there is no login screen). Create it with
# scripts/create_demo_user.py as a role=viewer user.
VITE_DEMO_USERNAME=demo_viewer

# REQUIRED. !! THIS VALUE IS SHIPPED IN THE PUBLIC BUNDLE !! Anyone who opens the
# site can read it. Use a dedicated low-privilege viewer account whose password
# is used nowhere else, and rotate it if it leaks. Leave blank in this file.
VITE_DEMO_PASSWORD=

# OPTIONAL but recommended in production. URL that receives runtime error
# reports as a JSON POST (see src/lib/errorReporter.ts). Any HTTP collector or
# log drain works; this repo ships no receiver. Unset = console-only.
VITE_ERROR_REPORT_URL=
