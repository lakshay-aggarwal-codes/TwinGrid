
# ---- T10 BEGIN: notification mail (docs/env/T10.md) ----
# smtp = real email (Gmail app password); console / file = development only; disabled = send nothing.
# Unset: console in development, disabled in production.
ACCESS_NOTIFY_BACKEND=
ACCESS_NOTIFY_OWNER_EMAIL=
ACCESS_NOTIFY_FROM=
ACCESS_NOTIFY_SMTP_HOST=smtp.gmail.com
ACCESS_NOTIFY_SMTP_PORT=587
ACCESS_NOTIFY_SMTP_USER=
# Gmail app password (16 characters; spaces ignored). Also supported: ACCESS_NOTIFY_SMTP_PASSWORD_FILE.
ACCESS_NOTIFY_SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) or none (local test servers only).
ACCESS_NOTIFY_SMTP_TLS=starttls
ACCESS_NOTIFY_TIMEOUT_S=10
ACCESS_NOTIFY_FILE_DIR=reports/dev_outbox
# Public URL used in email links; must be https:// in production. Also used by the access-request backend.
ACCESS_PUBLIC_BASE_URL=
# ---- T10 END ----
