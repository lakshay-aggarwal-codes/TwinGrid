PORT=8000
ENVIRONMENT=production
HOST=0.0.0.0

# Schema is owned by `alembic upgrade head`. create_all at startup is dev-only:
# default ON unless ENVIRONMENT=production; override with AUTO_CREATE_TABLES=true|false.
# For a DB previously built by create_all, run `alembic stamp 20250222200000` once first.
AUTO_CREATE_TABLES=false
RUN_MIGRATIONS=1

# Any of postgres://, postgresql:// or postgresql+asyncpg:// is accepted --
# database.py and alembic/env.py normalise it to postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digital_twin

# REQUIRED: the API refuses to start without it.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Registering a user with role "operator" requires the header
#   X-Admin-Key: <this value>
# If this is unset/empty, operator registration is disabled (403).
OPERATOR_REGISTRATION_KEY=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8080

LOG_LEVEL=INFO
LOG_FILE=logs/api.log

MAX_IT_POWER_KW=500
IDLE_POWER_FRACTION=0.4
AIR_FLOW_M3_S=8.0

ALPHA=0.5
BETA=0.3
GAMMA=0.2

ANOMALY_DETECTOR_PATH=models/anomaly
OPTIMIZER_MODEL_PATH=models/optimizer

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Data Ingestion Configuration
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key_here
NSRDB_API_KEY=your_nrel_nsrdb_api_key_here
NSRDB_EMAIL=your_registered_email@example.com
NSRDB_LATITUDE=28.6139
NSRDB_LONGITUDE=77.2090
NSRDB_YEAR=2020
