PORT=8000
ENVIRONMENT=production
HOST=0.0.0.0

# Schema is owned by `alembic upgrade head`. create_all at startup is dev-only:
# default ON unless ENVIRONMENT=production; override with AUTO_CREATE_TABLES=true|false.
# For a DB previously built by create_all, run `alembic stamp 20250222200000` once first.
AUTO_CREATE_TABLES=false
RUN_MIGRATIONS=1

# Any of postgres://, postgresql:// or postgresql+asyncpg:// is accepted --
# database.py and alembic/env.py normalise it to postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digital_twin

# REQUIRED: the API refuses to start without it.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Any secret below can instead be supplied as a file -- set <NAME>_FILE to
# the file's path (e.g. JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret) and
# leave the plain var unset. This is how Docker secrets, Kubernetes secrets
# mounted as files, and Vault Agent / AWS Secrets Manager sidecars hand a
# process its secrets without it ever appearing as plaintext in the
# environment (see api/secrets.py). Applies to JWT_SECRET_KEY,
# OPERATOR_REGISTRATION_KEY, and DATABASE_URL.
JWT_SECRET_KEY=your-secret-key-here-change-in-production
# Access-token lifetime, minutes. Short-lived on purpose -- clients refresh
# via POST /auth/refresh instead of holding one long-lived token.
JWT_EXPIRE_MINUTES=15
# Refresh-token lifetime, days. A refresh token is revoked on every use
# (rotation) and can be revoked early via POST /auth/logout.
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Registering a user with role "operator" requires the header
#   X-Admin-Key: <this value>
# If this is unset/empty, operator registration is disabled (403).
OPERATOR_REGISTRATION_KEY=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed by CORS.
# REQUIRED (no fallback) when ENVIRONMENT=production -- see api/config.py.
CORS_ALLOWED_ORIGINS=http://localhost:8080

LOG_LEVEL=INFO
LOG_FILE=logs/api.log

MAX_IT_POWER_KW=500
IDLE_POWER_FRACTION=0.4
AIR_FLOW_M3_S=8.0

ALPHA=0.5
BETA=0.3
GAMMA=0.2

ANOMALY_DETECTOR_PATH=models/anomaly
OPTIMIZER_MODEL_PATH=models/optimizer

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Task queue (Phase 4) -- required only if you use POST /api/optimize/train_async;
# the existing synchronous POST /api/optimize doesn't need this.
REDIS_URL=redis://localhost:6379/0

# Data Ingestion Configuration
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key_here
NSRDB_API_KEY=your_nrel_nsrdb_api_key_here
NSRDB_EMAIL=your_registered_email@example.com
NSRDB_LATITUDE=28.6139
NSRDB_LONGITUDE=77.2090
NSRDB_YEAR=2020
