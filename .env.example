PORT=8000
# Must be exactly one of: development | test | production (anything else, e.g. "prod", fails startup).
# production applies the strict startup rules in api/startup_checks.py: the placeholder values in THIS file
# (JWT_SECRET_KEY, OPERATOR_REGISTRATION_KEY, METRICS_TOKEN, the postgres:postgres DATABASE_URL) are rejected
# there. They are accepted under development/test. Error messages list variable NAMES, never values.
ENVIRONMENT=production
HOST=0.0.0.0

# Schema is owned by `alembic upgrade head`. create_all at startup is dev-only:
# default ON unless ENVIRONMENT=production; override with AUTO_CREATE_TABLES=true|false.
# For a DB previously built by create_all, run `alembic stamp 20250222200000` once first.
AUTO_CREATE_TABLES=false
RUN_MIGRATIONS=1

# Any of postgres://, postgresql:// or postgresql+asyncpg:// is accepted --
# database.py and alembic/env.py normalise it to postgresql+asyncpg://.
# Production rejects an unset DATABASE_URL and the default postgres:postgres credentials.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/digital_twin
# docker compose only (not read by the app): both are REQUIRED by docker-compose.yml, URL-safe characters only.
# The Postgres port is not published; use `docker compose --profile debug-db up -d debug-db` for 127.0.0.1:5432.
POSTGRES_PASSWORD=change-me-url-safe-postgres-password
REDIS_PASSWORD=change-me-url-safe-redis-password

# REQUIRED: the API refuses to start without it.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Any secret below can instead be supplied as a file -- set <NAME>_FILE to
# the file's path (e.g. JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret) and
# leave the plain var unset. This is how Docker secrets, Kubernetes secrets
# mounted as files, and Vault Agent / AWS Secrets Manager sidecars hand a
# process its secrets without it ever appearing as plaintext in the
# environment (see api/secrets.py). Applies to JWT_SECRET_KEY,
# OPERATOR_REGISTRATION_KEY, and DATABASE_URL.
JWT_SECRET_KEY=your-secret-key-here-change-in-production
# Access-token lifetime, minutes. Short-lived on purpose -- clients refresh
# via POST /auth/refresh instead of holding one long-lived token.
JWT_EXPIRE_MINUTES=15
# Refresh-token lifetime, days. A refresh token is revoked on every use
# (rotation) and can be revoked early via POST /auth/logout.
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Registering a user with role "operator" requires the header
#   X-Admin-Key: <this value>
# If this is unset/empty, operator registration is disabled (403).
OPERATOR_REGISTRATION_KEY=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed by CORS.
# REQUIRED (no fallback) when ENVIRONMENT=production -- see api/config.py.
# Production also rejects "*".
CORS_ALLOWED_ORIGINS=http://localhost:8080

# GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>". MANDATORY (>= 32 chars) in production; optional
# in development/test (open when unset). Can be supplied as METRICS_TOKEN_FILE.
#   python -c "import secrets; print(secrets.token_hex(32))"
METRICS_TOKEN=change-me-to-a-long-random-metrics-token

# HTTP limits (api/config.py). Values shown are the defaults.
RATE_LIMIT_STATE=30/minute
RATE_LIMIT_WHATIF=30/minute
RATE_LIMIT_BENCHMARK=30/minute
RATE_LIMIT_SIMULATE=6/minute
RATE_LIMIT_ANOMALY_SCORE=30/minute
RATE_LIMIT_ESG_REPORT=6/minute
RATE_LIMIT_SHADOW_SAMPLE=10/minute
RATE_LIMIT_ALERT_ACK=30/minute
RATE_LIMIT_WEBHOOK=30/minute
RATE_LIMIT_OPTIMIZE=10/minute
RATE_LIMIT_TRAIN_ASYNC=5/minute
MAX_QUERY_STRING_CHARS=8192
# Honour X-Forwarded-For only when the app is reachable exclusively through that many trusted proxies.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1

# WebSocket limits (api/config.py). Values shown are the defaults; WS_ALLOWED_ORIGINS empty = Origin not enforced.
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_GLOBAL=200
WS_MAX_MESSAGE_BYTES=1024
WS_MAX_MESSAGES_PER_MINUTE=30
WS_ALLOWED_ORIGINS=

LOG_LEVEL=INFO
LOG_FILE=logs/api.log

MAX_IT_POWER_KW=500
IDLE_POWER_FRACTION=0.4
AIR_FLOW_M3_S=8.0

# NOT READ by any .py file under api/, src/, scripts/ or alembic/ as of Stage 15
# (ALPHA, BETA, GAMMA, HOST, LOG_LEVEL, LOG_FILE, ELECTRICITY_MAPS_API_KEY).
# Kept only so nobody is surprised by their removal; setting them has no effect.
ALPHA=0.5
BETA=0.3
GAMMA=0.2

ANOMALY_DETECTOR_PATH=models/anomaly
OPTIMIZER_MODEL_PATH=models/optimizer

# Sensor ingestion (src/sensor_ingestion.py). Names below are the ones the code
# actually reads -- an earlier revision of this file used MQTT_BROKER_HOST /
# MQTT_BROKER_PORT, which nothing reads, so setting them silently did nothing.
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=digital_twin/sensors
MQTT_CLIENT_ID=digital_twin_ingestion
MQTT_BACKOFF_INITIAL=1.0
MQTT_BACKOFF_MAX=60.0
# Reject sensor payloads older than this many seconds.
SENSOR_FRESHNESS_SECONDS=300
# 1/true/yes = generate synthetic sensor data instead of reading MQTT (dev/demo only; production refuses to start with it on).
MOCK_SENSORS=0
MOCK_INTERVAL_SECONDS=5.0

# Alert notifications (src/alert_system.py). All optional: a channel with no
# credentials configured is simply not used.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=

# Data Ingestion Configuration
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key_here
NSRDB_API_KEY=your_nrel_nsrdb_api_key_here
NSRDB_EMAIL=your_registered_email@example.com
NSRDB_LATITUDE=28.6139
NSRDB_LONGITUDE=77.2090
NSRDB_YEAR=2020

# ---- Telemetry store and MQTT (T17) ----
# Rollback: TELEMETRY_STORE_ENABLED=false and TELEMETRY_WINDOW_SOURCE=memory (legacy sensor_readings write + in-memory window).
TELEMETRY_STORE_ENABLED=true
# store = anomaly window built from stored samples; memory = in-process ring buffer.
TELEMETRY_WINDOW_SOURCE=store
# Longest to-from accepted by GET /api/telemetry/sensors/{external_id}/samples|gaps.
TELEMETRY_MAX_SPAN_H=168
# Facility whose sensors fac<ID>.<measurand> feed the anomaly window (see scripts/seed_facility.py --seed-sensors).
TELEMETRY_FACILITY_ID=1
# Optional JSON override of the feature -> sensor external_id mapping (must cover exactly the five features).
TELEMETRY_FEATURE_SENSORS=
RATE_LIMIT_TELEMETRY_READ=60/minute
# MQTT consumer (python -m src.sensor_ingestion; broker settings above). Production requires the credentials.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Bound of the in-process queue; on overflow the OLDEST message is dropped (mqtt_dropped_total{reason="overflow"}).
MQTT_QUEUE_MAX=10000

# ---- Core request limits and runtime (api/config.py; found missing by tests/test_startup_checks.py in the Task 32 sweep) ----
# Rate limit of every route that has no scope of its own.
RATE_LIMIT_GENERAL=120/minute
# false/0/no/off switches the per-client request-rate windows off (rollback). Body cap, timeout and concurrency bound stay on.
HTTP_LIMITS_ENABLED=true
# Larger request bodies are rejected with 413 (bytes; default 1 MiB).
MAX_BODY_BYTES=1048576
# Compute-heavy requests in flight per process; more get 429.
MAX_CONCURRENT_COMPUTE=4
# Live feed fan-out: isolated (default, per-client queues) or sequential (rollback: awaited one-by-one send).
BROADCAST_MODE=isolated
# false skips the Alembic-head check in /readyz (only for databases built with create_all).
READYZ_CHECK_SCHEMA=true

# ---- WebSocket tickets and login lockout (Task 6; docs/env/Task6.md) ----
# Lifetime of a WebSocket ticket in seconds (malformed or <= 0 -> 30; capped at 300).
WS_TICKET_TTL_SECONDS=30
# false closes /ws/live?token= (4001); only tickets work. Production with false requires REDIS_URL (startup rule R13).
WS_ALLOW_QUERY_TOKEN=true
# Ticket store. Unset = per-process memory in development/test only; production then answers 503 on POST /auth/ws-ticket.
REDIS_URL=
# auto = follows the shared rate-limit switch; true always on; false off.
LOGIN_LOCKOUT_ENABLED=auto
# Consecutive failures per (IP, username) before the first lock.
LOGIN_LOCKOUT_THRESHOLD=5
# First lock in seconds; doubles per further failure.
LOGIN_LOCKOUT_BASE_SECONDS=30
# Cap on one lock in seconds.
LOGIN_LOCKOUT_MAX_SECONDS=900
# Failures are forgotten after this many seconds without one.
LOGIN_LOCKOUT_RESET_SECONDS=900

# ---- Response performance (Task 24; docs/env/Task24.md) ----
# All optional. ETag and gzip are on by default; the response cache is off unless PERF_CACHE_NAMESPACES and REDIS_URL are both set.
PERF_ETAG=1
PERF_GZIP=1
PERF_GZIP_MIN_BYTES=1024
# Comma-separated paths that get an ETag; empty = the built-in list.
PERF_ETAG_PATHS=
# state and/or scenarios; empty = cache off.
PERF_CACHE_NAMESPACES=
PERF_CACHE_STATE_TTL_S=2.0
PERF_CACHE_SCENARIOS_TTL_S=30.0

# ---- What-if sweep and tariff cost (Tasks 15 and 25; docs/env/Task15.md, docs/env/Task25.md) ----
RATE_LIMIT_WHATIF_SWEEP=6/minute
RATE_LIMIT_ECONOMICS=12/minute

# ---- Capacity planner (Task 26; docs/env/Task26.md) ----
# GET /api/capacity/headroom: each call is two 24 h twin runs executed as one unit under the shared compute bound.
RATE_LIMIT_CAPACITY=12/minute

# ---- Carbon-aware scheduling suggestions (Task 27; docs/env/Task27.md) ----
# GET /api/carbon/schedule: reads the memoised carbon signal, does not run the twin.
RATE_LIMIT_CARBON_SCHEDULE=30/minute

# ---- Maintenance work orders (Task 28; docs/env/Task28.md) ----
# No new variable: GET /api/maintenance/health uses RATE_LIMIT_TELEMETRY_READ and work-order writes use RATE_LIMIT_ALERT_ACK (both above).

# ---- T13 BEGIN (docs/env/T13.md) ----
# Anonymous read-only demo session (POST /auth/demo-session). Off unless set to true.
# DEMO_PUBLIC_ENABLED=false
# DEMO_SESSION_MINUTES=30
# DEMO_SESSION_RATE_LIMIT=20/hour
# ---- T13 END ----
