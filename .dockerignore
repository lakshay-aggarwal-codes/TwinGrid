# Never ship the ~3GB external-dataset folder inside the image -- the
# containerized API reads trained MODELS (mounted via docker-compose.yml),
# not raw source data.
realData/
data/cleaned/
data/features/
data/predictions/

# Local dev artifacts
.git/
.gitignore
__pycache__/
*.pyc
.venv/
venv/
.env
.env.local
# Per-machine env files (.env.demo, .env.mail, ...) and local secret files must never be COPY'd into an image layer.
.env.*
!.env.example
secrets/

# Abandoned frontend prototypes (see Phase 1 audit) -- not part of the
# backend image at all
vo/
bolt-main/
twin-stream-insight-main/

# Docs/tests not needed at runtime
tests/
*.md
logs/
